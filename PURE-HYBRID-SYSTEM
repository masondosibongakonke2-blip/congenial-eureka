import numpy as np
import json
from typing import List, Dict, Any

class PureHybridAnalyticEngine:
    def __init__(self, pitch_length: float = 105.0, pitch_width: float = 68.0):
        self.pitch_length = pitch_length
        self.pitch_width = pitch_width

    def cognitive_shadow_compliance(
        self, defender_pos: np.ndarray, attacker_pos: np.ndarray, target_distance: float = 1.5, tolerance: float = 0.3
    ) -> Dict[str, Any]:
        distance = np.linalg.norm(defender_pos - attacker_pos)
        deviation = distance - target_distance
        in_shadow_band = abs(deviation) <= tolerance
        return {
            "metric": "Cognitive Shadow",
            "distance_m": float(round(distance, 2)),
            "target_m": target_distance,
            "in_shadow_band": bool(in_shadow_band),
            "deviation_m": float(round(deviation, 2)),
            "status": "COMPLIANT" if in_shadow_band else ("TOO_LOOSE" if deviation > 0 else "TOO_AGGRESSIVE")
        }

    def chaos_pocket_density(
        self, player_positions: List[np.ndarray], pocket_center: np.ndarray, radius: float = 7.5
    ) -> Dict[str, Any]:
        player_arr = np.array(player_positions)
        if player_arr.size == 0:
            return {"players_in_pocket": 0, "density_per_m2": 0.0}
        distances = np.linalg.norm(player_arr - pocket_center, axis=1)
        count = int(np.sum(distances <= radius))
        area = np.pi * (radius ** 2)
        density = count / area
        return {
            "metric": "Relational Chaos Density",
            "players_in_pocket": count,
            "pocket_radius_m": radius,
            "density_per_m2": float(round(density, 4)),
            "overload_achieved": count >= 4
        }

    def swarm_closure_simulation(
        self, swarm_start_positions: List[np.ndarray], target_pos: np.ndarray, avg_sprint_speed: float = 6.5
    ) -> Dict[str, Any]:
        swarm_arr = np.array(swarm_start_positions)
        if swarm_arr.size == 0:
            return {"closure_time_s": 0.0, "meets_2_5s_target": False}
        distances = np.linalg.norm(swarm_arr - target_pos, axis=1)
        times = distances / avg_sprint_speed
        max_time = float(np.max(times))
        min_time = float(np.min(times))
        return {
            "metric": "Hounddog Swarm Closure",
            "individual_times_s": [float(round(t, 2)) for t in times],
            "trap_snap_time_s": float(round(max_time, 2)),
            "first_contender_time_s": float(round(min_time, 2)),
            "target_threshold_s": 2.5,
            "meets_2_5s_target": max_time <= 2.5
        }

    def weak_side_isolation(
        self, winger_pos: np.ndarray, nearest_defender_pos: np.ndarray, isolation_threshold: float = 5.0
    ) -> Dict[str, Any]:
        isolation_distance = np.linalg.norm(winger_pos - nearest_defender_pos)
        return {
            "metric": "Weak-Side Isolation",
            "isolation_distance_m": float(round(isolation_distance, 2)),
            "high_leverage_1v1": bool(isolation_distance >= isolation_threshold),
            "exploitation_readiness": "HIGH" if isolation_distance >= 7.0 else ("OPTIMAL" if isolation_distance >= 5.0 else "SUB_OPTIMAL")
        }

